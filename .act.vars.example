# act variables — copy to .act.vars (make act-init) and adjust.

# Marks the run as local. Workflows gate on vars.LOCAL_ACT, never env.ACT:
# env.ACT does not work in a job-level `if:`, and Gitea's runners also set
# ACT=true, which would make a real CI run mistake itself for a local one.
LOCAL_ACT=1
